  "probe": {
    "files": {
      "main.mbt": "///|\nfn bytewalk(data : BytesView, count : Int32) -> Array[Int64] {\n  @encoders.decode_int64(data, count) catch { _ => abort(\"original decode failed\") }\n}\n\n///|\nfn bulk(data : BytesView, count : Int32) -> Array[Int64] {\n  if count < 0 || count > data.length() / 8 { abort(\"invalid probe input\") }\n  let out = Array::make(count, 0L)\n  for index in 0..<count {\n    out[index] = data.unsafe_read_uint64_le(index * 8).reinterpret_as_int64()\n  }\n  out\n}\n\n///|\nfn main {\n  let n = 500000\n  let values = Array::makei(n, fn(i) {\n    (i.to_int64() * 104729L) ^ (i.to_int64() << 37)\n  })\n  values[0] = -9223372036854775808L\n  values[1] = 9223372036854775807L\n  values[2] = -1L\n  let out = Buffer()\n  @encoders.encode_int64(values, out)\n  let bytes = out.to_bytes()\n  let original = bytewalk(bytes, n)\n  let candidate = bulk(bytes, n)\n  for index in 0..<n {\n    if original[index] != values[index] || candidate[index] != values[index] {\n      abort(\"probe value mismatch\")\n    }\n  }\n  if bulk(b\"\", 0).length() != 0 { abort(\"empty probe mismatch\") }\n  println(\"guard: 500000 varied int64s and empty input agree\")\n  let b = @bench.Bench()\n  b.bench(name=\"plain64-bytewalk-A\", fn() { b.keep(bytewalk(bytes, n)) }, count=7)\n  b.bench(name=\"plain64-bulk-A\", fn() { b.keep(bulk(bytes, n)) }, count=7)\n  b.bench(name=\"plain64-bulk-B\", fn() { b.keep(bulk(bytes, n)) }, count=7)\n  b.bench(name=\"plain64-bytewalk-B\", fn() { b.keep(bytewalk(bytes, n)) }, count=7)\n  println(b.dump_summaries())\n}\n",
      "moon.pkg": "import {\n  \"superbigcup325/colenc/encoders\",\n  \"moonbitlang/core/bench\",\n}\npkgtype(kind: \"executable\")\n"
    },
